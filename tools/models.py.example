from os import getenv

# Example shortcut entry — copy this pattern for each model you want to scrape.
# `customer_id` and the workspace id are shared across every model in the same
# tenant/workspace; only `model_id` differs per model. Add `<PREFIX>_MODEL_ID`
# (and a workspace var if it's a new workspace) to `.env`, uncomment and adapt
# the block below, then register it in MODELS.
#
# modela = {
#     "name": "ModelA",
#     # Folder under raw/models/ holding this model's CSV export. REQUIRED by
#     # fetch_model_data.py. It is a separate key because "name" does not always
#     # match the folder: a shortcut named "modela" can point at a folder
#     # called "ModelA 2.0", and abbreviations rarely match folder names.
#     "raw_dir": "ModelA 2.0",
#     # Vault folder under customers/ this model belongs to.
#     "folder": "CustomerA",
#     # Bare Anaplan app shard token this tenant logs into (e.g. "eu2a", "eu3").
#     "shard": "eu2a",
#     "customer_id": getenv("CUSTOMER_ID"),
#     "workspace_id": getenv("MODELA_WORKSPACE"),
#     "model_id": getenv("MODELA_MODEL_ID"),
# }

